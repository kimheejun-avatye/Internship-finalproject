POSTGRES_PORT=5433
POSTGRES_DB=meeting_room
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_PORT=6379
REDIS_PASSWORD=redis

# Authentication: generate a random value of at least 32 characters; never commit .env
SECRET_KEY=
APP_ENV=development
APP_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173
COMPANY_IPS=127.0.0.1,::1
# Optional local SMTP. Production requires both account and password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CODE_TTL_SECONDS=300
EMAIL_HOURLY_LIMIT=5
